<Project>

  <PropertyGroup>
    <!--
      AssemblyVersion is intentionally pinned to 1.0.0.0 so that WPF resource URIs
      generated by MarkupCompilePass1 (e.g. "/AssemblyName;V1.0.0.0;component/...")
      remain stable and always match the compiled assembly's identity.
      FileVersion and InformationalVersion are still derived from git tags by MinVer.
    -->
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <MinVerDefaultPreReleaseIdentifiers>alpha.0</MinVerDefaultPreReleaseIdentifiers>
    <!--
      Set a repository-unique value here to differentiate MinVer's MSBuild cache key
      from sibling repositories that consume this project as a submodule. MinVer 7
      caches its computed version per-MSBuildNode keyed only on its inputs, so when
      this project is built alongside projects from another git repo in the same
      node, the cached result can leak across repos.
    -->
    <MinVerMinimumMajorMinor>5.0</MinVerMinimumMajorMinor>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MinVer" Version="7.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!--
    MinVer 7 unconditionally overwrites AssemblyVersion in its target.
    Restore the pinned value after MinVer runs, so the generated AssemblyInfo
    matches the version that MarkupCompilePass1 already baked into the BAML URIs.
  -->
  <Target Name="RestorePinnedAssemblyVersionAfterMinVer"
          AfterTargets="MinVer"
          BeforeTargets="GetAssemblyVersion;GenerateAssemblyInfo">
    <PropertyGroup>
      <AssemblyVersion>1.0.0.0</AssemblyVersion>
    </PropertyGroup>
  </Target>

</Project>
