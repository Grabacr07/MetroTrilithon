<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:interactivity="clr-namespace:Amethystra.UI.Interactivity">

    <DataTemplate DataType="{x:Type interactivity:InputDialogModel}">
        <interactivity:InputDialogContent />
    </DataTemplate>

    <DataTemplate DataType="{x:Type interactivity:TextDialogModel}">
        <interactivity:TextDialogContent />
    </DataTemplate>

</ResourceDictionary>
