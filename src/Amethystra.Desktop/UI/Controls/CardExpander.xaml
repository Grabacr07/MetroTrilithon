<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:ctrls="clr-namespace:Amethystra.UI.Controls">

    <!--
        CardExpander のカスタムスタイル。
        - ヘッダー部分のマウスホバー時に色変化を追加（コンテンツ領域にホバーしても反応しない）
        - 展開領域の Background と Border を除去してコンテンツの自由な描画を可能にする

        注意: このファイルは URI 経由で独立してロードされるため、BasedOn で WPF-UI の
        implicit style を参照できない。WPF-UI のセッターをすべて DynamicResource で再定義する。
    -->

    <ControlTemplate x:Key="Style.CardExpander.Fluent.ToggleButtonTemplate"
                     TargetType="{x:Type ToggleButton}">
        <Border Padding="{TemplateBinding Padding}"
                Background="Transparent">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ContentPresenter x:Name="ContentPresenter"
                                  Grid.Column="0"
                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                  Content="{TemplateBinding Content}" />
                <Grid x:Name="ChevronGrid"
                      Grid.Column="1"
                      Margin="0"
                      VerticalAlignment="Center"
                      Background="Transparent"
                      RenderTransformOrigin="0.5, 0.5">
                    <Grid.RenderTransform>
                        <RotateTransform Angle="0" />
                    </Grid.RenderTransform>
                    <ui:SymbolIcon x:Name="ControlChevronIcon"
                                   FontSize="{DynamicResource CardExpanderChevronSize}"
                                   Foreground="{TemplateBinding Foreground}"
                                   Symbol="ChevronDown24" />
                </Grid>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsChecked"
                     Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="ChevronGrid"
                                             Storyboard.TargetProperty="(Grid.RenderTransform).(RotateTransform.Angle)"
                                             To="180"
                                             Duration="00:00:00.167" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="ChevronGrid"
                                             Storyboard.TargetProperty="(Grid.RenderTransform).(RotateTransform.Angle)"
                                             To="0"
                                             Duration="00:00:00.167" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="Style.CardExpander.Fluent"
           TargetType="{x:Type ui:CardExpander}">
        <Style.Resources>
            <!-- 展開・折りたたみアニメーションは Trigger.EnterActions/ExitActions ではなくここに切り出して、
                 CardExpanderAnimationHelper.IsAnimationManaged 経由でコードから明示的に再生する。
                 これによって初回ロード時に IsExpanded=True であってもアニメーションが走らない。 -->
            <Storyboard x:Key="Style.CardExpander.Fluent.ExpandStoryboard">
                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_ContentPresenterBorder"
                                               Storyboard.TargetProperty="(Border.Visibility)">
                    <DiscreteObjectKeyFrame KeyTime="0"
                                            Value="{x:Static Visibility.Visible}" />
                </ObjectAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PART_ContentPresenterBorder"
                                               Storyboard.TargetProperty="(ctrls:CardExpanderAnimationHelper.AnimationTagValue)">
                    <DiscreteDoubleKeyFrame KeyTime="0"
                                            Value="1.0" />
                    <SplineDoubleKeyFrame KeySpline="0.0, 0.0, 0.0, 1.0"
                                          KeyTime="0:0:0.333"
                                          Value="0.0" />
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>
            <Storyboard x:Key="Style.CardExpander.Fluent.CollapseStoryboard">
                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_ContentPresenterBorder"
                                               Storyboard.TargetProperty="(Border.Visibility)">
                    <DiscreteObjectKeyFrame KeyTime="0"
                                            Value="{x:Static Visibility.Visible}" />
                    <DiscreteObjectKeyFrame KeyTime="0:0:0.2"
                                            Value="{x:Static Visibility.Collapsed}" />
                </ObjectAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PART_ContentPresenterBorder"
                                               Storyboard.TargetProperty="(ctrls:CardExpanderAnimationHelper.AnimationTagValue)">
                    <DiscreteDoubleKeyFrame KeyTime="0"
                                            Value="0.0" />
                    <SplineDoubleKeyFrame KeySpline="1.0, 1.0, 0.0, 1.0"
                                          KeyTime="0:0:0.167"
                                          Value="1.0" />
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>
        </Style.Resources>
        <Setter Property="ctrls:CardExpanderAnimationHelper.IsAnimationManaged"
                Value="True" />
        <Setter Property="FocusVisualStyle"
                Value="{DynamicResource DefaultControlFocusVisualStyle}" />
        <Setter Property="Background"
                Value="{DynamicResource CardBackground}" />
        <Setter Property="Foreground"
                Value="{DynamicResource CardForeground}" />
        <Setter Property="BorderBrush"
                Value="{DynamicResource CardBorderBrush}" />
        <Setter Property="BorderThickness"
                Value="{DynamicResource CardExpanderBorderThemeThickness}" />
        <Setter Property="Padding"
                Value="{DynamicResource CardExpanderPadding}" />
        <Setter Property="ContentPadding"
                Value="0" />
        <Setter Property="HorizontalAlignment"
                Value="Stretch" />
        <Setter Property="VerticalAlignment"
                Value="Center" />
        <Setter Property="HorizontalContentAlignment"
                Value="Stretch" />
        <Setter Property="VerticalContentAlignment"
                Value="Center" />
        <Setter Property="FontSize"
                Value="{DynamicResource ControlContentThemeFontSize}" />
        <Setter Property="FontWeight"
                Value="Normal" />
        <Setter Property="CornerRadius"
                Value="{DynamicResource ControlCornerRadius}" />
        <Setter Property="IsExpanded"
                Value="False" />
        <Setter Property="SnapsToDevicePixels"
                Value="True" />
        <Setter Property="OverridesDefaultStyle"
                Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ui:CardExpander}">
                    <ControlTemplate.Resources>
                        <ctrls:AnimationFactorToValueConverter x:Key="AnimationFactorToValueConverter" />
                        <ctrls:CornerRadiusTopConverter x:Key="CornerRadiusTopConverter" />
                    </ControlTemplate.Resources>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border x:Name="ToggleButtonBorder"
                                Grid.Row="0"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1">
                            <Border.CornerRadius>
                                <MultiBinding Converter="{StaticResource CornerRadiusTopConverter}">
                                    <Binding RelativeSource="{RelativeSource TemplatedParent}"
                                             Path="CornerRadius" />
                                    <Binding RelativeSource="{RelativeSource TemplatedParent}"
                                             Path="IsExpanded" />
                                </MultiBinding>
                            </Border.CornerRadius>
                            <ToggleButton x:Name="ExpanderToggleButton"
                                          Margin="0"
                                          Padding="{TemplateBinding Padding}"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          HorizontalContentAlignment="Stretch"
                                          VerticalContentAlignment="Center"
                                          FontSize="{TemplateBinding FontSize}"
                                          Foreground="{TemplateBinding Foreground}"
                                          IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          IsEnabled="{TemplateBinding IsEnabled}"
                                          OverridesDefaultStyle="True"
                                          Template="{StaticResource Style.CardExpander.Fluent.ToggleButtonTemplate}">
                                <ToggleButton.Content>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <ContentControl x:Name="ControlIcon"
                                                        Grid.Column="0"
                                                        Margin="{DynamicResource CardExpanderIconMargin}"
                                                        VerticalAlignment="Center"
                                                        Content="{TemplateBinding Icon}"
                                                        Focusable="False"
                                                        FontSize="{DynamicResource CardExpanderIconSize}"
                                                        Foreground="{TemplateBinding Foreground}"
                                                        KeyboardNavigation.IsTabStop="False" />

                                        <ContentPresenter x:Name="HeaderContentPresenter"
                                                          Grid.Column="1"
                                                          Content="{TemplateBinding Header}"
                                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                                    </Grid>
                                </ToggleButton.Content>
                            </ToggleButton>
                        </Border>

                        <Grid Grid.Row="1"
                              ClipToBounds="True">
                            <Border x:Name="PART_ContentPresenterBorder"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Visibility="Collapsed">
                                <ContentPresenter x:Name="ContentPresenter"
                                                  Margin="{TemplateBinding ContentPadding}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  Content="{TemplateBinding Content}" />
                                <Border.RenderTransform>
                                    <TranslateTransform>
                                        <TranslateTransform.Y>
                                            <MultiBinding Converter="{StaticResource AnimationFactorToValueConverter}"
                                                          ConverterParameter="negative">
                                                <Binding ElementName="PART_ContentPresenterBorder"
                                                         Path="ActualHeight" />
                                                <Binding ElementName="PART_ContentPresenterBorder"
                                                         Path="(ctrls:CardExpanderAnimationHelper.AnimationTagValue)" />
                                            </MultiBinding>
                                        </TranslateTransform.Y>
                                    </TranslateTransform>
                                </Border.RenderTransform>
                            </Border>
                        </Grid>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <!-- ヘッダー (ToggleButton) にホバーしたときの色変化。
                             Background と Foreground は常に効かせるが、BorderBrush は折りたたみ時のみ
                             上書きする。展開中はカード外側の Style が指定する BorderBrush
                             (例: 背景画像を見せるための Transparent) を尊重する。 -->
                        <DataTrigger Binding="{Binding IsMouseOver, ElementName=ExpanderToggleButton}"
                                     Value="True">
                            <Setter TargetName="ToggleButtonBorder"
                                    Property="Background"
                                    Value="{DynamicResource CardBackgroundPointerOver}" />
                            <Setter TargetName="ExpanderToggleButton"
                                    Property="Foreground"
                                    Value="{DynamicResource CardForegroundPointerOver}" />
                        </DataTrigger>

                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsMouseOver, ElementName=ExpanderToggleButton}"
                                           Value="True" />
                                <Condition Binding="{Binding IsChecked, ElementName=ExpanderToggleButton}"
                                           Value="False" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="ToggleButtonBorder"
                                    Property="BorderBrush"
                                    Value="{DynamicResource ControlElevationBorderBrush}" />
                        </MultiDataTrigger>

                        <!-- IsExpanded=True のスライドアニメーションは ctrls:CardExpanderAnimationHelper が
                             コードから Style.Resources の Storyboard を再生する形で扱う。 -->

                        <Trigger Property="IsEnabled"
                                 Value="False">
                            <Setter Property="Background"
                                    Value="{DynamicResource CardBackgroundDisabled}" />
                            <Setter Property="BorderBrush"
                                    Value="{DynamicResource CardBorderBrushDisabled}" />
                            <Setter TargetName="ContentPresenter"
                                    Property="TextElement.Foreground"
                                    Value="{DynamicResource CardForegroundDisabled}" />
                            <Setter TargetName="ExpanderToggleButton"
                                    Property="Foreground"
                                    Value="{DynamicResource CardForegroundDisabled}" />
                        </Trigger>

                        <Trigger Property="Icon"
                                 Value="{x:Null}">
                            <Setter TargetName="ControlIcon"
                                    Property="Margin"
                                    Value="0" />
                            <Setter TargetName="ControlIcon"
                                    Property="Visibility"
                                    Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
