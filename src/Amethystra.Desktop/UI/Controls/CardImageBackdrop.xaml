<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:controls="clr-namespace:Amethystra.UI.Controls"
                    xmlns:converters="clr-namespace:Amethystra.UI.Converters">

    <!--
        Default style for CardImageBackdrop.
        - RootGrid hosts the rounded clip (RectangleGeometry driven by ActualSize).
        - The implicit ui:CardExpander style inside RootGrid.Resources makes any inner
          CardExpander's Background / BorderBrush transparent while IsExpanded == True, so
          callers do not need to declare this style locally. It is BasedOn the local
          Style.CardExpander.Fluent so the Fluent visuals are preserved.
        - The image stack (sharp VectorImage + N blur overlays) lives behind the
          ContentPresenter and is gated by IsActive / dimmed by IsDimmed.
    -->

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Amethystra.Desktop;component/UI/Controls/CardExpander.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <converters:SizeToRectConverter x:Key="Converter.SizeToRect" />
    <converters:BooleanToVisibilityConverter x:Key="Converter.BooleanToVisibility" />

    <Style TargetType="{x:Type controls:CardImageBackdrop}">
        <!--
            Style.Resources are visible to logical descendants of the templated element,
            including the Content (which is typically an ui:CardExpander). Placing the
            implicit CardExpander style here is more reliable than placing it inside the
            template's Grid.Resources, which is only visible to the visual subtree of
            the template root.
        -->
        <Style.Resources>
            <Style TargetType="ui:CardExpander"
                   BasedOn="{StaticResource Style.CardExpander.Fluent}">
                <Style.Triggers>
                    <Trigger Property="IsExpanded"
                             Value="True">
                        <Setter Property="Background"
                                Value="Transparent" />
                        <Setter Property="BorderBrush"
                                Value="Transparent" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Style.Resources>
        <Setter Property="HorizontalContentAlignment"
                Value="Stretch" />
        <Setter Property="VerticalContentAlignment"
                Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:CardImageBackdrop}">
                    <Grid x:Name="RootGrid">
                        <Grid.Clip>
                            <RectangleGeometry RadiusX="{Binding CornerRadius, RelativeSource={RelativeSource TemplatedParent}}"
                                               RadiusY="{Binding CornerRadius, RelativeSource={RelativeSource TemplatedParent}}">
                                <RectangleGeometry.Rect>
                                    <MultiBinding Converter="{StaticResource Converter.SizeToRect}">
                                        <Binding ElementName="RootGrid"
                                                 Path="ActualWidth" />
                                        <Binding ElementName="RootGrid"
                                                 Path="ActualHeight" />
                                    </MultiBinding>
                                </RectangleGeometry.Rect>
                            </RectangleGeometry>
                        </Grid.Clip>

                        <Grid x:Name="PART_ImageLayers"
                              Visibility="{TemplateBinding IsActive, Converter={StaticResource Converter.BooleanToVisibility}}">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Opacity"
                                            Value="1.0" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDimmed, RelativeSource={RelativeSource AncestorType={x:Type controls:CardImageBackdrop}}}"
                                                     Value="True">
                                            <Setter Property="Opacity"
                                                    Value="{Binding DimmedOpacity, RelativeSource={RelativeSource AncestorType={x:Type controls:CardImageBackdrop}}}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>

                            <controls:VectorImage Source="{TemplateBinding Source}"
                                                  Stretch="UniformToFill" />

                            <ItemsControl ItemsSource="{Binding Overlays, RelativeSource={RelativeSource TemplatedParent}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Grid />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type controls:BlurOverlay}">
                                        <Border OpacityMask="{Binding Mask}">
                                            <Border.Effect>
                                                <BlurEffect Radius="{Binding Radius}" />
                                            </Border.Effect>
                                            <controls:VectorImage Source="{Binding Source, RelativeSource={RelativeSource AncestorType={x:Type controls:CardImageBackdrop}}}"
                                                                  Stretch="UniformToFill" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>

                        <ContentPresenter x:Name="PART_Content"
                                          Content="{TemplateBinding Content}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
